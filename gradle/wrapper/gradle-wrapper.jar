name: Generate and Verify Gradle Wrapper

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  wrapper:
    name: Generate, Validate and Build
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      # IMPORTANT:
      # Replace the repository's existing wrapper JAR BEFORE any Gradle
      # action runs, because setup-gradle performs wrapper validation itself.
      - name: Install official Gradle 8.13 Wrapper JAR
        shell: bash
        run: |
          set -euo pipefail

          mkdir -p gradle/wrapper

          curl --fail --silent --show-error --location \
            --retry 5 \
            --retry-delay 2 \
            --output gradle/wrapper/gradle-wrapper.jar \
            https://services.gradle.org/distributions/gradle-8.13-wrapper.jar

      - name: Verify Gradle 8.13 Wrapper JAR checksum
        shell: bash
        run: |
          set -euo pipefail

          EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
          ACTUAL="$(sha256sum gradle/wrapper/gradle-wrapper.jar | cut -d' ' -f1)"

          echo "Expected: ${EXPECTED}"
          echo "Actual:   ${ACTUAL}"

          if [ "${ACTUAL}" != "${EXPECTED}" ]; then
            echo "::error::Gradle 8.13 Wrapper JAR checksum mismatch."
            exit 1
          fi

          echo "Gradle 8.13 Wrapper JAR checksum verified."

      - name: Validate Gradle Wrapper
        uses: gradle/actions/wrapper-validation@v6

      - name: Set up Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle 8.13
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "8.13"
          validate-wrappers: true

      - name: Generate Gradle Wrapper metadata
        shell: bash
        run: |
          set -euo pipefail

          gradle wrapper \
            --gradle-version 8.13 \
            --distribution-type bin

      # The wrapper task can rewrite the JAR, so verify it AGAIN.
      - name: Re-verify official Wrapper JAR
        shell: bash
        run: |
          set -euo pipefail

          EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
          ACTUAL="$(sha256sum gradle/wrapper/gradle-wrapper.jar | cut -d' ' -f1)"

          echo "Expected: ${EXPECTED}"
          echo "Actual:   ${ACTUAL}"

          test "${ACTUAL}" = "${EXPECTED}"

      - name: Validate final Gradle Wrapper
        uses: gradle/actions/wrapper-validation@v6

      - name: Verify wrapper files
        shell: bash
        run: |
          set -euo pipefail

          test -f gradle/wrapper/gradle-wrapper.jar
          test -f gradle/wrapper/gradle-wrapper.properties
          test -f gradlew
          test -f gradlew.bat

          chmod +x gradlew

      - name: Verify Gradle version
        run: ./gradlew --version

      - name: Build Debug APK
        run: ./gradlew assembleDebug --no-daemon

      - name: Commit verified wrapper
        shell: bash
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add \
            gradle/wrapper/gradle-wrapper.jar \
            gradle/wrapper/gradle-wrapper.properties \
            gradlew \
            gradlew.bat

          if git diff --cached --quiet; then
            echo "No wrapper changes to commit."
            exit 0
          fi

          git commit -m "build: add verified Gradle 8.13 wrapper"
          git push
