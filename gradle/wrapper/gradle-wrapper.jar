name: Generate and Verify Gradle Wrapper

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  wrapper:
    name: Verify Gradle 8.13 Wrapper and Build APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Download official Gradle 8.13 Wrapper JAR
        shell: bash
        run: |
          set -euo pipefail

          mkdir -p gradle/wrapper

          curl --fail --location --retry 5 \
            -o gradle/wrapper/gradle-wrapper.jar \
            https://services.gradle.org/distributions/gradle-8.13-wrapper.jar

      - name: Verify official Gradle 8.13 Wrapper JAR
        shell: bash
        run: |
          set -euo pipefail

          EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
          ACTUAL="$(sha256sum gradle/wrapper/gradle-wrapper.jar | awk '{print $1}')"

          echo "Expected SHA-256: $EXPECTED"
          echo "Actual SHA-256:   $ACTUAL"

          if [ "$ACTUAL" != "$EXPECTED" ]; then
            echo "::error::Downloaded JAR is not the official Gradle 8.13 Wrapper JAR."
            exit 1
          fi

          echo "Official Gradle 8.13 Wrapper JAR verified."

      - name: Validate Gradle Wrapper
        uses: gradle/actions/wrapper-validation@v6

      - name: Set up Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle 8.13
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "8.13"
          validate-wrappers: true

      - name: Verify wrapper
        shell: bash
        run: |
          set -euo pipefail

          chmod +x gradlew

          test -f gradle/wrapper/gradle-wrapper.jar
          test -f gradle/wrapper/gradle-wrapper.properties
          test -f gradlew
          test -f gradlew.bat

          SHA256="$(sha256sum gradle/wrapper/gradle-wrapper.jar | awk '{print $1}')"
          test "$SHA256" = "81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"

          ./gradlew --version

      - name: Build Debug APK
        run: ./gradlew assembleDebug --no-daemon

      - name: Commit verified wrapper
        shell: bash
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add \
            gradle/wrapper/gradle-wrapper.jar \
            gradle/wrapper/gradle-wrapper.properties \
            gradlew \
            gradlew.bat

          if git diff --cached --quiet; then
            echo "Wrapper is already current and verified."
            exit 0
          fi

          git commit -m "build: add verified Gradle 8.13 wrapper"
          git push
